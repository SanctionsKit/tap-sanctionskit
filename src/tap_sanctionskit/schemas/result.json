{
  "type": "object",
  "required": [
    "id",
    "environment",
    "status",
    "createdAt",
    "matches",
    "coverage",
    "versions",
    "disclaimer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Screening UUID; use it to retrieve retained result/evidence and locate linked review cases."
    },
    "environment": {
      "enum": [
        "sandbox",
        "production"
      ],
      "description": "Environment owned by the API key. Sandbox evidence is synthetic."
    },
    "status": {
      "enum": [
        "potential_match",
        "no_match"
      ],
      "description": "potential_match requires review of candidates; no_match means no returned candidates within the selected coverage and matching rules. Neither is a business approval or legal clearance."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Screening creation timestamp in ISO 8601 UTC."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record",
          "score",
          "evidence",
          "conflicts"
        ],
        "properties": {
          "record": {
            "type": "object",
            "required": [
              "id",
              "sourceId",
              "authority",
              "list",
              "sourceUrl",
              "entityType",
              "names",
              "identifiers",
              "birthDates",
              "addresses",
              "nationalities",
              "designations",
              "extensions"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              },
              "authority": {
                "type": "string"
              },
              "list": {
                "type": "string"
              },
              "sourceUrl": {
                "type": "string"
              },
              "entityType": {
                "type": "string",
                "enum": [
                  "person",
                  "organization",
                  "vessel",
                  "aircraft",
                  "other"
                ]
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "kind"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "primary",
                        "alias"
                      ]
                    },
                    "quality": {
                      "enum": [
                        "strong",
                        "weak",
                        "unknown"
                      ]
                    },
                    "script": {
                      "type": "string"
                    },
                    "provenance": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string"
                        },
                        "recordId": {
                          "type": "string"
                        },
                        "field": {
                          "type": "string"
                        },
                        "rawValue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceId",
                        "recordId",
                        "field"
                      ],
                      "description": "Publisher field attribution. rawValue is optional; when present it preserves the original published value."
                    }
                  }
                }
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "issuer": {
                      "type": "string"
                    },
                    "provenance": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string"
                        },
                        "recordId": {
                          "type": "string"
                        },
                        "field": {
                          "type": "string"
                        },
                        "rawValue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceId",
                        "recordId",
                        "field"
                      ],
                      "description": "Publisher field attribution. rawValue is optional; when present it preserves the original published value."
                    }
                  }
                }
              },
              "birthDates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "precision",
                    "original"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "precision": {
                      "enum": [
                        "day",
                        "month",
                        "year",
                        "range",
                        "unknown"
                      ]
                    },
                    "original": {
                      "type": "string"
                    }
                  }
                }
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "country": {
                      "type": "string"
                    },
                    "provenance": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string"
                        },
                        "recordId": {
                          "type": "string"
                        },
                        "field": {
                          "type": "string"
                        },
                        "rawValue": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceId",
                        "recordId",
                        "field"
                      ],
                      "description": "Publisher field attribution. rawValue is optional; when present it preserves the original published value."
                    }
                  }
                }
              },
              "nationalities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "designations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "category",
                    "programs",
                    "legalReferences"
                  ],
                  "properties": {
                    "category": {
                      "enum": [
                        "financial_sanctions",
                        "export_control",
                        "debarment",
                        "other"
                      ]
                    },
                    "programs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "legalReferences": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "wording": {
                      "type": "string"
                    },
                    "effectiveDate": {
                      "type": "string"
                    }
                  }
                }
              },
              "dataThrough": {
                "type": "string",
                "format": "date",
                "description": "Inclusive publisher data-availability deadline; not a legal end date."
              },
              "screeningPeriods": {
                "type": "array",
                "maxItems": 1000,
                "description": "Inclusive UTC date intervals for current screening. Omitted means no date filter; an empty array excludes the record from current screening.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "string",
                      "format": "date"
                    },
                    "through": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              },
              "publicContext": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                }
              },
              "extensions": {
                "type": "object",
                "additionalProperties": true,
                "description": "Source-specific published extensions. Keys and value shapes vary by source; preserve unknown values without assuming a fixed schema."
              }
            }
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Legacy composite review score retained for compatibility. Use assessment.name.similarity for name similarity and assessment for corroboration and conflicts. Not a probability of identity or wrongdoing."
          },
          "assessment": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "similarity": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "method": {
                        "type": "string"
                      },
                      "aliasKind": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "alias"
                        ]
                      },
                      "aliasQuality": {
                        "type": "string",
                        "enum": [
                          "strong",
                          "weak",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "similarity",
                      "method",
                      "aliasKind",
                      "aliasQuality"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "identifiers": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "agreement",
                      "conflict",
                      "not_supplied",
                      "unavailable",
                      "not_comparable"
                    ]
                  },
                  "matched": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "issuerAgreements": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "issuerUnknown": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "conflicts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "status",
                  "matched",
                  "issuerAgreements",
                  "issuerUnknown",
                  "conflicts"
                ],
                "additionalProperties": false
              },
              "birthDate": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "agreement",
                      "conflict",
                      "not_supplied",
                      "unavailable",
                      "not_comparable"
                    ]
                  },
                  "precision": {
                    "type": "string",
                    "enum": [
                      "year",
                      "month",
                      "day"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              "country": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "agreement",
                      "conflict",
                      "not_supplied",
                      "unavailable",
                      "not_comparable"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              "entityType": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "agreement",
                      "conflict",
                      "not_supplied",
                      "unavailable",
                      "not_comparable"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              "reviewTier": {
                "type": "string",
                "enum": [
                  "identifier",
                  "corroborated",
                  "conflicting",
                  "name_only"
                ]
              },
              "alertBasis": {
                "type": "string",
                "enum": [
                  "identifier",
                  "name",
                  "name_and_birth_date",
                  "partial_name"
                ]
              },
              "hasConflicts": {
                "type": "boolean"
              },
              "sameNameCandidates": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "identifiers",
              "birthDate",
              "country",
              "entityType",
              "reviewTier",
              "alertBasis",
              "hasConflicts",
              "sameNameCandidates"
            ],
            "additionalProperties": false,
            "description": "Retained name similarity, identity comparison states and review evidence tier. Contains no copied subject values. Missing information, conflicts and partial dates remain distinct; an evidence tier is not a finding of identity or wrongdoing."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "queryValue",
                "sourceValue",
                "method",
                "contribution",
                "explanation"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "queryValue": {
                  "type": "string"
                },
                "sourceValue": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "contribution": {
                  "type": "number"
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Candidate records with field evidence and conflicts. Always an array; empty for no_match. No silent truncation is performed."
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "version",
          "retrievedAt",
          "fresh"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "description": "Authority-supplied publication date (YYYY-MM-DD) or RFC 3339 timestamp, preserving the precision supplied by the publisher. A date-only value does not imply midnight or a timezone. Omitted when no genuine publication date or timestamp is supplied."
          },
          "fresh": {
            "type": "boolean"
          },
          "sourceNotice": {
            "type": "object",
            "required": [
              "text",
              "sourceUrl",
              "termsUrl"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "Required publisher attribution and reuse notices captured when screening runs."
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "termsUrl": {
                "type": "string",
                "format": "uri"
              },
              "licenseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Only included for a reviewed explicit license instrument."
              },
              "databaseDownloadUrl": {
                "type": "string",
                "format": "uri-reference",
                "description": "Free complete derivative database for the exact immutable source version, where required. A relative path resolves against this API origin."
              }
            },
            "description": "Included in new production screening results, including no-match results. Absent from synthetic sandbox coverage and older retained evidence; historical evidence is not rewritten."
          }
        }
      },
      "description": "Exact source versions used, including freshness and retained publisher notices. Always present, including no_match."
    },
    "versions": {
      "type": "object",
      "required": [
        "dataset",
        "matchingEngine",
        "policy"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "matchingEngine": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "description": "Dataset, matching engine and policy versions used for this result. package is included only for package-based coverage."
    },
    "disclaimer": {
      "type": "string",
      "description": "Interpretation limits supplied with this result; preserve them when presenting or exporting evidence."
    },
    "policySnapshot": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "purpose": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "jurisdictions": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "matching": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "standard",
                "focused"
              ]
            },
            "partialNames": {
              "type": "string",
              "enum": [
                "review",
                "exclude"
              ]
            }
          },
          "required": [
            "profile"
          ],
          "additionalProperties": false
        },
        "requiredSources": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "person",
              "organization",
              "vessel",
              "aircraft",
              "other"
            ]
          },
          "additionalProperties": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "optionalSources": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "person",
              "organization",
              "vessel",
              "aircraft",
              "other"
            ]
          },
          "additionalProperties": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "exclusions": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "externalChecks": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "externalCheckGuidance": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "instructions": {
                "type": "string",
                "minLength": 3,
                "maxLength": 2000
              },
              "evidenceExample": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1000
              }
            },
            "required": [
              "label",
              "instructions"
            ],
            "additionalProperties": false
          }
        },
        "review": {
          "default": {},
          "type": "object",
          "properties": {
            "requireSecondReview": {
              "default": false,
              "type": "boolean"
            },
            "secondReviewFor": {
              "default": [],
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "same_identity",
                  "allow",
                  "restrict",
                  "escalate"
                ]
              }
            },
            "approverRoles": {
              "default": [
                "owner",
                "admin",
                "analyst"
              ],
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "owner",
                  "admin",
                  "analyst"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "monitoringIntervalHours": {
          "default": 24,
          "anyOf": [
            {
              "type": "number",
              "const": 6
            },
            {
              "type": "number",
              "const": 24
            },
            {
              "type": "number",
              "const": 168
            }
          ]
        },
        "retentionTrigger": {
          "default": "review_completed",
          "type": "string",
          "enum": [
            "review_completed",
            "relationship_ended",
            "business_event"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "purpose",
        "jurisdictions",
        "requiredSources",
        "optionalSources",
        "exclusions",
        "externalChecks",
        "review",
        "monitoringIntervalHours",
        "retentionTrigger",
        "id",
        "version",
        "environment",
        "createdAt"
      ],
      "additionalProperties": false,
      "description": "Immutable organization policy applied at screening time, when one was selected. Omitted when no organization policy applied."
    },
    "matching": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": [
            "standard",
            "focused"
          ]
        },
        "nameThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "corroboratedNameThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "retrievalVersion": {
          "type": "string"
        },
        "partialNames": {
          "type": "string",
          "enum": [
            "review",
            "exclude"
          ]
        }
      },
      "required": [
        "version",
        "profile",
        "nameThreshold",
        "corroboratedNameThreshold",
        "retrievalVersion"
      ],
      "additionalProperties": false,
      "description": "Applied Standard or Focused alert profile, comparison thresholds, partial-name policy and retrieval version. Saved with new results, including no-match results; omitted on historical results without this evidence. Set matching.partialNames to review on an approved screening policy to include weaker token-prefix and missing-name-part evidence. Omission or exclude preserves complete-name matching. Select sensitivity through a versioned policy, not an arbitrary request-level cutoff."
    },
    "warnings": {
      "type": "array",
      "description": "Input limitations without copied subject values. A one-word person name produces limited_name_information; legitimate single-word names are accepted. Preserve this warning with no-match outcomes and retained evidence. Historical results may omit it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "limited_name_information"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Result returned by POST /screenings and plain GET /results items. Its required fields are always present. A successful result is either potential_match or no_match; failures use the Error envelope instead.",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
